# Logo - sett til /logo.png og legg logo i public/logo.png
# NEXT_PUBLIC_LOGO_URL=/logo.png

# Formspree - Form ID fra formspree.io
# NEXT_PUBLIC_FORMSPREE_ID=your-formspree-id

# Instagram - lenke til profil
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/din-profil

# Instagram-feed på forsiden (Instagram API med Instagram-login) - se README/instruks for hvordan disse hentes
# INSTAGRAM_USER_ID=din-instagram-business-konto-id
# INSTAGRAM_ACCESS_TOKEN=din-langvarige-access-token

# Skriverettighet i Sanity, brukes av /api/cron/refresh-instagram-token til å
# lagre et fornyet Instagram-token automatisk hver natt. Opprett en token med
# "Editor"-rettigheter på manage.sanity.io -> prosjektet -> API -> Tokens
# SANITY_API_TOKEN=

# Beskytter cron-endepunktet - sett samme verdi her og som miljøvariabel i Vercel
# CRON_SECRET=

# Analytics - se ANALYTICS.md
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id
# GOOGLE_SITE_VERIFICATION=your-verification-code
