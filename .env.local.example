# Kopier til .env.local og fyll inn verdiene

# Logo - legg logo i public/ (f.eks. logo.svg eller logo.png)
NEXT_PUBLIC_LOGO_URL=/logo.svg

# Formspree - Form ID fra formspree.io
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-id

# Instagram - lenke til profil (valgfritt)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/din-profil
