NEXT_PUBLIC_SANITY_PROJECT_ID=din-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4 — Measurement ID from GA4 Admin > Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity — Project ID from clarity.microsoft.com project settings
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id

# Google Search Console — verification code from the "HTML tag" method
# (just the content value, not the full <meta> tag)
GOOGLE_SITE_VERIFICATION=your-verification-code
